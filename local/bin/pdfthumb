#!/bin/sh

if ! [ -f "$1" ]; then
    echo "Error: File $1 not found." >&2
    exit 1
fi

cache="/tmp/thumb"
index="$cache/index-pdf.json"
pdf="$(realpath "$1")"

mkdir -p "$cache"

if [ -f "$index" ]; then
    thumbnail="$(jq -r ".\"$pdf\"" <"$index")"
    if [[ "$thumbnail" != "null" ]]; then
        if [[ -f "$cache/$thumbnail" ]]; then
            echo "$cache/$thumbnail"
            exit 0
        fi
    fi
fi

thumbnail="$(uuidgen)-pdf.png"

if ! gs -dSAFER -dBATCH -dNOPAUSE -sDEVICE=png16m -dFirstPage=1 -dLastPage=1 \
   -r144 -sOutputFile="$cache/$thumbnail" "$pdf" 2>> /tmp/thumb/pdferror.log; then
    echo "Error: Failed to generate thumbnail for PDF: $pdf" >&2
    exit 1
fi

if [[ ! -f "$index" ]]; then
    echo "{\"$pdf\": \"$thumbnail\"}" > "$index"
else
    json=$(jq -r --arg pdf "$pdf" --arg thumbnail "$thumbnail" '. + {($pdf): $thumbnail}' "$index" 2>> /tmp/thumb/pdfjq.log)
    if [[ $? -ne 0 ]]; then
        echo "Error: Failed to update index.json with jq" >&2
        exit 1
    fi
    echo "$json" > "$index"
fi

echo "$cache/$thumbnail"
